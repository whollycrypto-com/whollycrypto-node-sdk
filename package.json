{
  "name": "whollycrypto",
  "version": "2.3.1",
  "description": "Official Node.js SDK for the Wholly Crypto merchant API, with JavaScript and TypeScript support.",
  "license": "MIT",
  "author": "Wholly Crypto",
  "homepage": "https://www.whollycrypto.com/documentation/#sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whollycrypto-com/whollycrypto-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/whollycrypto-com/whollycrypto-node-sdk/issues"
  },
  "keywords": [
    "whollycrypto",
    "crypto",
    "payments",
    "merchant",
    "bitcoin",
    "lightning",
    "sdk",
    "typescript"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "examples",
    "docs/payment-methods.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/build-entrypoints.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "check": "npm run build && npm test && npm run test:types"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "5.9.3"
  }
}
